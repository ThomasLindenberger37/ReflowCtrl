{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ESP-IDF: Build",
      "type": "shell",
      "command": "env",
      "args": [
        "-u",
        "ESPPORT",
        "idf.py",
        "build"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ],
      "presentation": {
        "group": "esp-idf",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "ESP-IDF: Flash",
      "type": "shell",
      "command": "env",
      "args": [
        "-u",
        "ESPPORT",
        "idf.py",
        "-p",
        "${config:reflowPilot.serialPort}",
        "flash"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "group": "esp-idf",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "ESP-IDF: Monitor",
      "type": "shell",
      "command": "env",
      "args": [
        "-u",
        "ESPPORT",
        "idf.py",
        "-p",
        "${config:reflowPilot.serialPort}",
        "monitor"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "group": "esp-idf-monitor",
        "panel": "dedicated",
        "clear": true,
        "focus": true
      }
    },
    {
      "label": "ESP-IDF: Flash + Monitor",
      "type": "shell",
      "command": "env",
      "args": [
        "-u",
        "ESPPORT",
        "idf.py",
        "-p",
        "${config:reflowPilot.serialPort}",
        "flash",
        "monitor"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "group": "esp-idf-monitor",
        "panel": "dedicated",
        "clear": true,
        "focus": true
      }
    },
    {
      "label": "ESP-IDF: Build + Flash",
      "dependsOrder": "sequence",
      "dependsOn": [
        "ESP-IDF: Build",
        "ESP-IDF: Flash"
      ],
      "problemMatcher": []
    },
    {
      "label": "ESP-IDF: Build + Flash + Monitor",
      "dependsOrder": "sequence",
      "dependsOn": [
        "ESP-IDF: Build",
        "ESP-IDF: Flash + Monitor"
      ],
      "problemMatcher": []
    },
    {
      "label": "Unit Tests: Build + Run",
      "type": "shell",
      "command": "cmake -S tests -B build/unit-tests && cmake --build build/unit-tests && ctest --test-dir build/unit-tests --output-on-failure",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "problemMatcher": [
        "$gcc"
      ],
      "presentation": {
        "group": "unit-tests",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "ESP-IDF: Build + Unit Tests",
      "dependsOrder": "sequence",
      "dependsOn": [
        "ESP-IDF: Build",
        "Unit Tests: Build + Run"
      ],
      "problemMatcher": []
    },
    {
      "label": "OTA: Start Server",
      "type": "shell",
      "command": "uv",
      "args": [
        "run",
        "python",
        "ota_server/server.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "group": "ota-server",
        "panel": "dedicated",
        "clear": true,
        "focus": true
      }
    },
    {
      "label": "ESP-IDF: Build + OTA",
      "dependsOrder": "sequence",
      "dependsOn": [
        "ESP-IDF: Build",
        "OTA: Start Server"
      ],
      "problemMatcher": []
    },
    {
      "label": "ESP-IDF: Clean",
      "type": "shell",
      "command": "env",
      "args": [
        "-u",
        "ESPPORT",
        "idf.py",
        "clean"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "group": "esp-idf",
        "panel": "shared",
        "clear": true
      }
    }
  ]
}
