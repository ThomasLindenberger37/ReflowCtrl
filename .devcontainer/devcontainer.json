{
  "name": "ESP32 DevContainer",
  "build": {
    "dockerfile": "Dockerfile",
    "target": "base"
  },
  "runArgs": [
    "--network=host"
  ],
  "privileged": true,
  "mounts": [
    "source=/dev/bus/usb,target=/dev/bus/usb,type=bind",
    "source=${localEnv:HOME}/.ssh,target=/home/vscode/.ssh,type=bind,readonly"
  ],
  "containerEnv": {
    "ESPPORT": "/dev/ttyACM0",
    "ESPBAUD": "115200"
  },
  "remoteUser": "vscode",
  "updateRemoteUserUID": false,
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools"
      ],
      "settings": {
        "C_Cpp.default.compilerPath": "/opt/esp/xtensa-lx106-elf/bin/xtensa-lx106-elf-gcc",
        "cmake.generator": "Ninja",
        "terminal.integrated.profiles.linux": {
          "zsh": {
            "path": "/usr/bin/zsh"
          }
        },
        "terminal.integrated.defaultProfile.linux": "zsh"
      }
    }
  }
}
